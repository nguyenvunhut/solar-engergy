        <mxCell id="col1" value="&lt;b&gt;1. THU NHẬN &amp; STREAMING&lt;/b&gt;&lt;br&gt;IoT Modbus Gateway (1s)&lt;br&gt;Apache Kafka Cluster&lt;br&gt;Open-Meteo REST API&lt;br&gt;Độ trễ &lt; 500ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="240" height="525" as="geometry" /></mxCell>
        <mxCell id="col2" value="&lt;b&gt;2. DATAOPS &amp; ORCHESTRATION&lt;/b&gt;&lt;br&gt;Apache Airflow DAGs&lt;br&gt;Data Observability Checksum&lt;br&gt;Spark / DuckDB Lakehouse&lt;br&gt;Tự động hóa 100% luồng dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="280" y="75" width="240" height="525" as="geometry" /></mxCell>
        <mxCell id="col3" value="&lt;b&gt;3. MLOPS &amp; GOVERNANCE&lt;/b&gt;&lt;br&gt;MLflow Model Registry&lt;br&gt;Concept Drift &amp; Auto-Retrain&lt;br&gt;Feast Feature Store&lt;br&gt;Vòng đời AI khép kín" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="540" y="75" width="240" height="525" as="geometry" /></mxCell>
