  <diagram id="diag-2-3" name="2.3 GMM-IF Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;KIẾN TRÚC MÔ HÌNH LAI 3 TẦNG GMM-IF VÀ 5 RÀO CHẮN VẬT LÝ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1020" height="46" as="geometry" /></mxCell>
        <mxCell id="inp" value="&lt;b&gt;1. ĐẦU VÀO TELEMETRY&lt;/b&gt;&lt;br&gt;X = [GHI, T_amb, Hour, DNI, DHI, P_stc]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="320" height="75" as="geometry" /></mxCell>
        <mxCell id="dt" value="&lt;b&gt;TẦNG 1: PHÂN ĐOẠN KHÔNG GIAN THỜI TIẾT (CART)&lt;/b&gt;&lt;br&gt;Băm không gian vận hành thành 19-29 vùng lá đồng nhất vi khí hậu (R² = 0.758)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="72" width="660" height="75" as="geometry" /></mxCell>
        <mxCell id="gmm" value="&lt;b&gt;TẦNG 2: GMM CỤC BỘ (LOCAL DENSITY)&lt;/b&gt;&lt;br&gt;P(x) = Σ π_k · N(x | μ_k, Σ_k) [M = 2]&lt;br&gt;Flag_GMM = 1 khi P_GMM &lt; 0.02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="500" height="150" as="geometry" /></mxCell>
        <mxCell id="if" value="&lt;b&gt;TẦNG 3: ISOLATION FOREST TOÀN CỤC&lt;/b&gt;&lt;br&gt;s(x, n) = 2^[-E(h(x))/c(n)] [100 iTrees]&lt;br&gt;Flag_IF = 1 khi Score_IF &gt; Ngưỡng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="500" height="150" as="geometry" /></mxCell>
        <mxCell id="consensus" value="&lt;b&gt;CƠ CHẾ ĐỒNG THUẬN NGHIÊM NGẶT: Flag_ML = Flag_GMM ∧ Flag_IF (Triệt tiêu &gt;80% cảnh báo giả)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="362" width="1020" height="52" as="geometry" /></mxCell>
        <mxCell id="rules" value="&lt;b&gt;5 RÀO CHẮN VẬT LÝ GHI ĐÈ ƯU TIÊN (PHYSICS-INFORMED RULES)&lt;/b&gt;&lt;br&gt;R1: Quá công suất STC | R2: Đêm phát điện | R3: Nắng yếu điện cao | R4: Nắng gắt điện 0 | R5: Chênh lệch mảng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="1020" height="115" as="geometry" /></mxCell>
        <mxCell id="out" value="&lt;b&gt;KẾT QUẢ ĐẦU RA: GÁN NHÃN FACT VÀ ĐIỀU PHỐI O&amp;M ISO 13374 (7.431 bản ghi ~ 0.27%)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#38BDF8;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1020" height="65" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
