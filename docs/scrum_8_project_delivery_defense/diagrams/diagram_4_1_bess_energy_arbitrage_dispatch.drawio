  <diagram id="diag-4-1" name="4.1 BESS Integration and Arbitrage">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;KIẾN TRÚC TÍCH HỢP HỆ THỐNG PIN LƯU TRỮ BESS (1.000 kW / 2.500 kWh) &amp;amp; ĐIỀU ĐỘ NĂNG LƯỢNG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1020" height="46" as="geometry" /></mxCell>
        <mxCell id="col1" value="&lt;b&gt;1. QUANG ĐIỆN &amp;amp; THU HỒI CẮT NGỌN&lt;/b&gt;&lt;br&gt;P_stc = 2.428 kWp (42 Trạm)&lt;br&gt;Clipping mất 2,3% (79.298 kWh/năm)&lt;br&gt;BESS DC-Coupled thu hồi 88%: 69.782 kWh/năm&lt;br&gt;Giá trị thu hồi: +15.352 AUD/Năm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="235" height="525" as="geometry" /></mxCell>
        <mxCell id="col2" value="&lt;b&gt;2. TRUNG TÂM LƯU TRỮ &amp;amp; ĐIỀU ĐỘ AI&lt;/b&gt;&lt;br&gt;Pin LiFePO4: 2.500 kWh (DoD 90%, 6000 chu kỳ)&lt;br&gt;Biến tần lưu trữ Hybrid: 1.000 kW (0.4C)&lt;br&gt;AI EMS: Dự báo LightGBM 15-phút (WAPE 12,48%)&lt;br&gt;Tự tiêu thụ: Tăng từ 68,2% lên 94,6%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="275" y="75" width="245" height="525" as="geometry" /></mxCell>
        <mxCell id="col3" value="&lt;b&gt;3. 3 KÊNH TẠO GIÁ TRỊ TÀI CHÍNH&lt;/b&gt;&lt;br&gt;• Dịch chuyển TOU tối (17h-21h): +163.812 AUD/Năm (642.400 kWh)&lt;br&gt;• Gọt đỉnh Demand Charge (800 kW): +144.000 AUD/Năm&lt;br&gt;• Thu hồi cắt ngọn: +15.352 AUD/Năm&lt;br&gt;&lt;b&gt;TỔNG LỢI ÍCH: +323.164 AUD/NĂM (712.182 kWh)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="540" y="75" width="245" height="525" as="geometry" /></mxCell>
        <mxCell id="col4" value="&lt;b&gt;4. ĐÁNH GIÁ TÀI CHÍNH &amp;amp; ROI&lt;/b&gt;&lt;br&gt;Tổng mức đầu tư CapEx: 1.250.000 AUD (500 AUD/kWh)&lt;br&gt;Dòng tiền ròng sau OpEx: +310.664 AUD/Năm&lt;br&gt;&lt;b&gt;HOÀN VỐN ĐẦU TƯ: 3,87 NĂM (~3 Năm 10 Tháng)&lt;/b&gt;&lt;br&gt;Tỷ suất IRR (15 năm): 24,6%&lt;br&gt;Giảm phát thải: ~655 tấn CO2/Năm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="805" y="75" width="235" height="525" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
