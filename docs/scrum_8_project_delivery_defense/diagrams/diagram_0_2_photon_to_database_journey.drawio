        <mxCell id="hdr" value="&lt;b&gt;HÀNH TRÌNH 4 BƯỚC: TỪ 1 TIA NẮNG MẶT TRỜI ĐẾN DÒNG DỮ LIỆU TELEMETRY TRONG DATABASE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="920" height="35" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;BƯỚC 1: TRÊN MÁI NHÀ&lt;/b&gt;&lt;br&gt;Tấm pin Silicon&lt;br&gt;Ánh nắng hất văng electron&lt;br&gt;Tạo dòng điện một chiều DC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="195" height="135" as="geometry" /></mxCell>
