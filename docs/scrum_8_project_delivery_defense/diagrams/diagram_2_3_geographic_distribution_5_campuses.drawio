        <mxCell id="hdr" value="&lt;b&gt;PHÂN BỐ ĐỊA LÝ &amp; THỐNG KÊ SỐ GIỜ OVER-IRRADIANCE (GHI &gt; 1.000 W/m²) TẠI 5 CAMPUS LA TROBE (VICTORIA, ÚC)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1020" height="46" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;BẢN ĐỒ VI KHÍ HẬU 5 CAMPUS LA TROBE (VICTORIA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Mildura&lt;/b&gt; (Tây Bắc Outback - Top-Left): 374,0 h/trạm | Max 1.109 W/m²&lt;br&gt;2. &lt;b&gt;Albury-Wodonga&lt;/b&gt; (Biên giới Đông Bắc - Top-Right): 189,0 h/trạm | Max 1.091 W/m²&lt;br&gt;3. &lt;b&gt;Shepparton&lt;/b&gt; (Thung lũng Goulburn - Giữa Bắc): 238,0 h/trạm | Max 1.088 W/m²&lt;br&gt;4. &lt;b&gt;Bendigo&lt;/b&gt; (Nội địa trung tâm - Giữa Tây): 282,0 h/trạm | Max 1.095 W/m²&lt;br&gt;5. &lt;b&gt;Bundoora&lt;/b&gt; (Melbourne duyên hải - Phía Nam): 126,0 h/trạm | Max 1.081 W/m²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="470" height="525" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;SỐ GIỜ OVER-IRRADIANCE TRUNG BÌNH TRÊN MỖI TRẠM (28 THÁNG)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Mildura: 374,0 giờ/trạm (Cao nhất toàn bang)&lt;br&gt;• Bendigo: 282,0 giờ/trạm&lt;br&gt;• Shepparton: 238,0 giờ/trạm&lt;br&gt;• Albury-Wodonga: 189,0 giờ/trạm&lt;br&gt;• Bundoora: 126,0 giờ/trạm (Thấp nhất)&lt;br&gt;&lt;br&gt;→ Trung bình toàn hệ thống: 171,8 giờ/trạm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="510" y="75" width="530" height="525" as="geometry" /></mxCell>
