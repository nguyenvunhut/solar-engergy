  <diagram id="diag-2-4" name="2.4 Causal Imputation &amp; Floor-Hour">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;CHIẾN LƯỢC ĐIỀN KHUYẾT NHÂN QUẢ 4 TẦNG &amp; CƠ CHẾ FLOOR-HOUR LOOKUP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1020" height="46" as="geometry" /></mxCell>
        <mxCell id="col1" value="&lt;b&gt;1. QUY TRÌNH ĐIỀN KHUYẾT 4 TẦNG (CAUSAL CASCADE)&lt;/b&gt;&lt;br&gt;Tầng 1: Luật đêm vật lý GHI ≤ 20 W/m² ∨ is_day == 0 ➔ E = 0.0 kWh (90.05%)&lt;br&gt;Tầng 2: Nội suy tuyến tính (≤ 2 chu kỳ / ≤ 30p, 3.49%) + Kẹp trần&lt;br&gt;Tầng 3: Nội suy PCHIP Spline đơn điệu (3 - 8 chu kỳ / 45p-2h, 3.30%) + Kẹp trần&lt;br&gt;Tầng 4: Hồi quy đa biến khí quyển ERA5-Land (&gt; 8 chu kỳ / &gt; 2h, 3.15%) + Kẹp trần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="500" height="525" as="geometry" /></mxCell>
        <mxCell id="col2" value="&lt;b&gt;2. CĂN CHỈNH KHÍ QUYỂN (FLOOR-HOUR LOOKUP)&lt;/b&gt;&lt;br&gt;Làm tròn sàn về đầu giờ: 09:00, 09:15, 09:30, 09:45 ➔ 09:00&lt;br&gt;Đảm bảo Δt = t_weather - t_solar ≤ 0&lt;br&gt;assert (weather_time &gt; solar_time).sum() == 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="540" y="75" width="500" height="525" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
