<mxfile host="app.diagrams.net" modified="2026-08-19T22:30:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="diag-1-1-definition" name="1.1 Cloud Enhancement Definition Curve">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="hdr" value="&lt;b&gt;TRỰC QUAN HÓA HIỆN TƯỢNG CLOUD ENHANCEMENT (OVER-IRRADIANCE) VS ĐƯỜNG TRỜI QUANG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1020" height="46" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;DIỄN BIẾN BỨC XẠ TOÀN PHẦN MẶT NGANG (GHI) TRONG NGÀY CÓ MÂY TÍCH CUMULUS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;Đường Trời Quang Lý Thuyết (Clear-Sky, CSI = 1.0):&lt;/b&gt;&lt;/font&gt; Parabol êm dịu, đỉnh giữa trưa ≈ 1.000 W/m²&lt;br&gt;• &lt;font color=&quot;#EA580C&quot;&gt;&lt;b&gt;Bức Xạ Thực Tế (GHI thực):&lt;/b&gt;&lt;/font&gt; Dao động mạnh, xuất hiện các xung nhọn Cloud Enhancement vọt lên 1.380 W/m² (CSI = 1,38)&lt;br&gt;• &lt;font color=&quot;#64748B&quot;&gt;&lt;b&gt;Vùng Bóng Mây Che (Dips):&lt;/b&gt;&lt;/font&gt; Bức xạ sụt sâu xuống 200 - 350 W/m² khi mây che đĩa Mặt Trời&lt;br&gt;• &lt;font color=&quot;#7E22CE&quot;&gt;&lt;b&gt;Hằng số Mặt Trời G_sc:&lt;/b&gt;&lt;/font&gt; 1.361 W/m² (Ngoài khí quyển)&lt;br&gt;• &lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Ngưỡng chuẩn STC:&lt;/b&gt;&lt;/font&gt; 1.000 W/m²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="670" height="525" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;ĐỊNH LƯỢNG VỚI CHỈ SỐ CSI &amp; Ý NGHĨA DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Công thức CSI:&lt;/b&gt; CSI = GHI_thực / GHI_trời_quang&lt;br&gt;&lt;br&gt;&lt;b&gt;2. 3 Trạng thái Khí tượng Bức xạ:&lt;/b&gt;&lt;br&gt;• Trời trong: CSI = 0,95 – 1,00&lt;br&gt;• Mây mù: CSI = 0,10 – 0,40&lt;br&gt;• Cloud Enhancement: &lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;CSI = 1,15 – 1,45&lt;/b&gt;&lt;/font&gt; (Vượt 15% - 45% lý thuyết!)&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Nguyên tắc Data Science:&lt;/b&gt;&lt;br&gt;• 100% là hiện tượng vật lý quang học thật&lt;br&gt;• Tuyệt đối KHÔNG xóa bỏ để huấn luyện ML dự báo phụ tải đỉnh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="705" y="75" width="335" height="525" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
