        <mxCell id="bi_hdr" value="2. TẦNG SIÊU THỊ DỮ LIỆU (SCHEMA: bi_mart — mv_bi_mart_hourly_measures)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=12.5;fontStyle=1;align=center;" vertex="1" parent="1">
