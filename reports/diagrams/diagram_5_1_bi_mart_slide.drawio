        <!-- Sub 1: fact_solar_energy_gen -->
        <mxCell id="box_fgen" value="fact_solar_energy_gen (Dữ liệu phát điện)&#xa;--------------------------------------------------------------------------------&#xa;• Chu kỳ đo 15 phút từ hệ thống cảm biến 42 trạm phát PV&#xa;• Lưu trữ chi tiết lịch sử sản lượng thực tế (2.73 triệu dòng)&#xa;• Định danh khóa chính và các khóa ngoại liên kết đa chiều" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontSize=10.8;fontColor=#1E3A8A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="146" width="715" height="132" as="geometry" />
        </mxCell>

        <!-- Sub 2: fact_weather -->
        <mxCell id="box_fw" value="fact_weather &amp; Các bảng Chiều (Dimensions)&#xa;--------------------------------------------------------------------------------&#xa;• Chu kỳ 1 giờ: Bức xạ mặt trời (GHI), Nhiệt độ, Mây, Gió (ERA5)&#xa;• 850.752 bản ghi khí tượng viễn thám độ chính xác cao&#xa;• Bảng chiều dùng chung: Trạm phát, Khuôn viên, Thời gian, Thời tiết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontSize=10.8;fontColor=#1E3A8A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="825" y="146" width="715" height="132" as="geometry" />
        </mxCell>


        <!-- ==================== KHỐI 2: TẦNG BI DATA MART (h = 240) ==================== -->
        <mxCell id="bi_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2.2;" vertex="1" parent="1">
          <mxGeometry x="35" y="340" width="1530" height="240" as="geometry" />
