        <mxCell id="arr1" value="Nén dữ liệu 15 phút -&gt; 1 giờ &amp; Ghép nối dữ liệu khí tượng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;strokeWidth=3;endArrow=classic;endFill=1;fontSize=11;fontStyle=1;fontColor=#14532D;" edge="1" parent="1" source="dwh_container" target="bi_container">
