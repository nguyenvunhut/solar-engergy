        <!-- HEADER BANNER (16:9 SLIDE TOP) -->
        <mxCell id="t0" value="KIẾN TRÚC TẦNG BI DATA MART (ÁNH XẠ CHỈ SỐ THEO DASHBOARD)&#xa;Phân nhóm chỉ số tính toán sẵn tại tầng BI Mart phục vụ trực tiếp cho từng Dashboard Tableau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
