        <mxCell id="dwh_hdr" value="1. TẦNG KHO DỮ LIỆU (SCHEMA: datawarehouse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#3B82F6;fontColor=#FFFFFF;fontSize=12.5;fontStyle=1;align=center;" vertex="1" parent="1">
