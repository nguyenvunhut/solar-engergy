<mxfile host="Electron" modified="2026-08-22T12:40:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diag_5_1" name="BI Mart Architecture &amp; Gestalt UI/UX">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- HEADER BANNER -->
        <mxCell id="t0" value="KIẾN TRÚC TẦNG BI DATA MART &amp; NGUYÊN TẮC THIẾT KẾ UI/UX GESTALT&#xa;Chuyển đổi tối ưu DWH sang Materialized Views | Bảng màu ngữ nghĩa WCAG 2.1 AA | Tối ưu hóa Tableau Dashboards (&lt; 100 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=13.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1540" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== CỘT 1: DWH VÀ CHIẾN LƯỢC TỐI ƯU TRUY VẤN ==================== -->
        <mxCell id="c1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="460" height="970" as="geometry" />
        </mxCell>
        <mxCell id="c1_hdr" value="1. NGUỒN DWH &amp; SO SÁNH KIẾN TRÚC BI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748B;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="440" height="35" as="geometry" />
        </mxCell>

        <!-- Box 1.1: Nguồn DWH 3.5M dòng -->
        <mxCell id="box_dwh_src" value="NGUỒN DỮ LIỆU DWH (SCHEMA: datawarehouse)&#xa;==================================================&#xa;• fact_solar_energy_gen (2.731.946 dòng - 15m):&#xa;  - PK: gen_id | FK: site_id, geo_id, date_id, time_id&#xa;  - Đo lường: energy_generated_kwh&#xa;  - Cờ ngoại lai: gmm_if_outlier_flag&#xa;• fact_weather (850.752 dòng ERA5-Land - 1h):&#xa;  - PK: weather_id | FK: geo_id, date_id, time_id&#xa;  - GHI, temp_c, cloud_cover, wind_speed&#xa;• 5 Bảng Chiều Chung (Conformed Dimensions):&#xa;  dim_solar_site, dim_geography, dim_date,&#xa;  dim_time, dim_weather_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;fontColor=#1E3A8A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="155" width="430" height="230" as="geometry" />
        </mxCell>

        <!-- Box 1.2: So sánh kiến trúc Standard View vs Physical vs MV -->
        <mxCell id="box_strategy" value="SO SÁNH CHIẾN LƯỢC THIẾT KẾ TẦNG BI&#xa;==================================================&#xa;❌ TÙY CHỌN 1: STANDARD VIEW (VIEW THƯỜNG)&#xa;• Quá tải tính toán: Thực hiện lại toàn bộ phép JOIN&#xa;  trên 3.5M dòng mỗi khi người dùng tương tác lọc.&#xa;• Độ trễ rất cao (5 – 10 giây) | Nguy cơ nghẽn RAM.&#xa;--------------------------------------------------&#xa;⚠️ TÙY CHỌN 2: BẢNG VẬT LÝ RIÊNG (PHYSICAL TABLE)&#xa;• Rủi ro lệch đồng bộ (Desync) khi DWH cập nhật.&#xa;• Tốn gấp đôi dung lượng đĩa &amp; phức tạp hóa ETL.&#xa;--------------------------------------------------&#xa;✅ GIẢI PHÁP DỰ ÁN: MATERIALIZED VIEWS&#xa;• Lưu kết quả tiền tổng hợp (Pre-aggregated) vào đĩa.&#xa;• Tích hợp sẵn Unique Composite Index.&#xa;• Tốc độ phản hồi Tableau: &lt; 100 ms (Zero Lag).&#xa;• Tự động REFRESH MATERIALIZED VIEW định kỳ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=9.8;fontColor=#0F172A;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="35" y="395" width="430" height="310" as="geometry" />
        </mxCell>

        <!-- Box 1.3: Tầng kết nối Tableau Serving -->
        <mxCell id="box_tableau_serving" value="TẦNG KHAI THÁC TABLEAU SERVING LAYER&#xa;==================================================&#xa;• Trình Kết Nối: PostgreSQL Direct qua Supabase Pooler&#xa;  (Host: aws-1-ap-southeast-1.pooler.supabase.com:5432)&#xa;• Phân Quyền An Toàn (Principle of Least Privilege):&#xa;  Tài khoản chuyên dụng tableau_user (Read-only bi_mart)&#xa;• Tableau Relationships (1:N):&#xa;  Liên kết trực tiếp MV với các Dimension tables,&#xa;  bảo toàn độ hạt, triệt tiêu hoàn toàn lỗi Fan-out.&#xa;• Phục vụ 3 Dashboards Chuyên Biệt:&#xa;  1. Executive Overview (BANs, Bản đồ trạm, Lũy kế)&#xa;  2. Efficiency &amp; Loss (Tổn thất nhiệt, Suy hao)&#xa;  3. Anomaly Detection &amp; O&amp;M (Cờ GMM-IF, Dòng rò)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=9.8;fontColor=#4C1D95;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="35" y="715" width="430" height="240" as="geometry" />
        </mxCell>


        <!-- ==================== CỘT 2: CẤU TRÚC MATERIALIZED VIEWS TRONG BI MART ==================== -->
        <mxCell id="c2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="560" height="970" as="geometry" />
        </mxCell>
        <mxCell id="c2_hdr" value="2. CẤU TRÚC 2 MATERIALIZED VIEWS LÕI (SCHEMA: bi_mart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="110" width="540" height="35" as="geometry" />
        </mxCell>

        <!-- Sub-box 2.1: mv_bi_mart_hourly_measures -->
        <mxCell id="box_mv_hourly" value="① bi_mart.mv_bi_mart_hourly_measures (CẤP GIỜ - 1H)&#xa;==========================================================&#xa;• Cơ Chế: Nén 4 mốc 15m về 1 khung giờ 1h (hourly_bucket),&#xa;  ghép nối nhân quả (Causal Join) với fact_weather.&#xa;----------------------------------------------------------&#xa;• ĐO LƯỜNG VẬT LÝ &amp; THÔNG SỐ TRẠM:&#xa;  - e_hourly (kWh) : Tổng sản lượng phát thực tế theo giờ&#xa;  - shortwave_radiation (W/m²), temperature_c (°C), wind_speed&#xa;  - t_cell = temp_c + (GHI * 0.035) : Nhiệt độ ô pin PV&#xa;  - p_stc : Công suất định danh danh định trạm (kWp)&#xa;----------------------------------------------------------&#xa;• HIỆU SUẤT &amp; SUY HAO NHIỆT ĐỘ:&#xa;  - e_stc_hourly = p_stc * (GHI / 1000.0) [khi GHI &gt;= 100 W/m²]&#xa;  - loss_temp = (t_cell - 25) * 0.004 [khi t_cell &gt; 25°C]&#xa;  - pr_actual = e_hourly / e_stc_hourly (Hiệu suất thực tế)&#xa;  - pr_adjusted = 0.78 * (1 - loss_temp) (Hiệu suất hiệu chỉnh nhiệt)&#xa;  - e_expected = e_stc_hourly * pr_adjusted (Sản lượng kỳ vọng)&#xa;----------------------------------------------------------&#xa;• CHỈ SỐ TÀI CHÍNH &amp; TÍN CHỈ MÔI TRƯỜNG:&#xa;  - estimated_revenue = e_hourly * 1.938 VNĐ/kWh (Giá FiT)&#xa;  - cost_of_underperformance = (e_expected - e_hourly) * 1.938 đ&#xa;  - co2_avoided_kg = e_hourly * 0.533 kg&#xa;  - equivalent_trees_planted = co2_avoided_kg / 21.8 kg&#xa;----------------------------------------------------------&#xa;• GIÁM SÁT SỰ CỐ &amp; MÃ LỖI O&amp;M:&#xa;  - gmm_if_outlier_flag (BOOL), gmm_if_outlier_reason&#xa;• UNIQUE INDEX: idx_mv_hourly_unique (date_id, site_id, hourly_bucket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=1.5;fontSize=9.5;fontColor=#064E3B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="515" y="155" width="530" height="425" as="geometry" />
        </mxCell>

        <!-- Sub-box 2.2: mv_bi_mart_daily_kpis -->
        <mxCell id="box_mv_daily" value="② bi_mart.mv_bi_mart_daily_kpis (CẤP NGÀY &amp; KPIS LŨY KẾ)&#xa;==========================================================&#xa;• Cơ Chế: Tổng hợp trực tiếp từ mv_bi_mart_hourly_measures&#xa;  nhóm theo (date_id, site_id, geo_id) cho 42 trạm phát.&#xa;----------------------------------------------------------&#xa;• CHỈ SỐ TỔNG HỢP VÀ HIỆU SUẤT CẤP NGÀY:&#xa;  - e_daily (kWh), e_stc_daily, e_target_daily&#xa;  - daily_revenue, daily_cost_underperformance, daily_co2_avoided&#xa;  - daily_pr_actual = e_daily / e_stc_daily (PR thực tế ngày)&#xa;  - daily_pr_adjusted = e_target_daily / e_stc_daily (PR hiệu chỉnh)&#xa;  - capacity_factor (CF) = e_daily / (p_stc * 24h)&#xa;  - yield_fulfillment_ratio = e_daily / e_target_daily (Đạt kế hoạch)&#xa;----------------------------------------------------------&#xa;• TIME-INTELLIGENCE WINDOW FUNCTIONS (LŨY KẾ):&#xa;  - wtd_energy : Lũy kế Tuần-đến-nay (Week-to-Date)&#xa;  - mtd_energy &amp; mtd_revenue : Lũy kế Tháng-đến-nay (Month-to-Date)&#xa;  - ytd_energy &amp; ytd_revenue : Lũy kế Năm-đến-nay (Year-to-Date)&#xa;----------------------------------------------------------&#xa;• GIÁM SÁT DỊ THƯỜNG TRẠM: has_gmm_outlier, daily_gmm_outlier_reasons&#xa;• TỰ ĐỘNG CẬP NHẬT: REFRESH MATERIALIZED VIEW CONCURRENTLY&#xa;• UNIQUE INDEX: idx_mv_daily_unique (date_id, site_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22C55E;strokeWidth=1.5;fontSize=9.5;fontColor=#064E3B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="515" y="595" width="530" height="360" as="geometry" />
        </mxCell>


        <!-- ==================== CỘT 3: UI/UX GESTALT & BẢNG MÀU NGỮ NGHĨA ==================== -->
        <mxCell id="c3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="480" height="970" as="geometry" />
        </mxCell>
        <mxCell id="c3_hdr" value="3. NGUYÊN TẮC THIẾT KẾ UI/UX GESTALT &amp; BẢNG MÀU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9D174D;strokeColor=#DB2777;fontColor=#FFFFFF;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="110" width="460" height="35" as="geometry" />
        </mxCell>

        <!-- Box 3.1: Nguyên tắc Gestalt & Data-Ink -->
        <mxCell id="box_gestalt" value="NGUYÊN TẮC THIẾT KẾ GESTALT &amp; TỶ SỐ DATA-INK&#xa;==================================================&#xa;1. Luật Gần Nhau (Law of Proximity):&#xa;   - Cấu trúc Card-based Container Layout gọn gàng, viền xám (#E2E8F0)&#xa;   - Nhóm các thành phần có quan hệ logic vào cùng một khối thẻ:&#xa;     [Khối BANs KPI Top Banner]  [Khối Bản đồ Địa lý &amp; Xếp hạng]&#xa;     [Khối Xu hướng Sản lượng]   [Khối Tổn thất &amp; Dị thường]&#xa;&#xa;2. Luật Đồng Nhất (Law of Similarity):&#xa;   - Các đối tượng cùng bản chất có cùng hình dáng, font và màu sắc&#xa;   - Điểm dị thường đồng nhất màu Đỏ (#E15759)&#xa;   - Đường chuẩn tham chiếu đồng nhất nét xám (#79706E)&#xa;&#xa;3. Tối Đa Hóa Tỷ Số Data-Ink (Tufte Data-Ink Ratio):&#xa;   - Loại bỏ triệt để rác thị giác (Chartjunk) &amp; nền màu rực rỡ thừa&#xa;   - Làm mờ/loại bỏ đường lưới phụ (minor gridlines), chỉ giữ đường gốc Zero&#xa;   - Tập trung 100% thị giác vào đường cong sản lượng và điểm lỗi&#xa;&#xa;4. Bố Cục Phân Tầng Thị Giác F-Pattern:&#xa;   - Thẻ chỉ số cốt lõi (BANs) đặt ở dải trên cùng (Top Banner, 18-24pt)&#xa;   - Dẫn dắt ánh mắt từ Tổng quan -&gt; Không gian -&gt; Chi tiết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F472B6;strokeWidth=1.5;fontSize=9.5;fontColor=#831843;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="155" width="450" height="380" as="geometry" />
        </mxCell>

        <!-- Box 3.2: Bảng màu ngữ nghĩa WCAG 2.1 AA -->
        <mxCell id="box_palette" value="BẢNG MÀU NGỮ NGHĨA CHUẨN WCAG 2.1 AA (≥ 4.5:1)&#xa;==================================================&#xa;🔵 XANH TEAL / NAVY (#4E79A7 &amp; #76B7B2 | Contrast 7.2:1)&#xa;   Sản lượng thực tế chuẩn (e_hourly), BANs tổng sản lượng,&#xa;   đường hiệu suất điều chỉnh nhiệt pr_adjusted.&#xa;&#xa;🟡 VÀNG CAM (#F28E2B &amp; #EDC948 | Contrast 4.8:1)&#xa;   Bức xạ mặt trời GHI, nhiệt độ ô pin t_cell,&#xa;   cảnh báo suy giảm hiệu suất nhẹ (50% &lt;= PR &lt; 75%).&#xa;&#xa;🔴 ĐỎ DỊ THƯỜNG (#E15759 | Contrast 5.1:1)&#xa;   ĐỘC QUYỀN đánh dấu cờ bất thường GMM-IF, dòng rò ban đêm (E &gt; 0),&#xa;   sụt giảm nghiêm trọng (PR &lt; 50%).&#xa;&#xa;🟢 XANH LÁ ECO (#59A14F | Contrast 4.9:1)&#xa;   Trạng thái tối ưu (PR &gt;= 75%), Hệ số công suất CF,&#xa;   tín chỉ môi trường CO2 tránh phát thải &amp; Cây xanh.&#xa;&#xa;⚪ XÁM TRUNG TÍNH (#79706E &amp; #E2E8F0 | Contrast 4.6:1)&#xa;   Reference Lines chuẩn, trục tọa độ, viền Container Card." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F472B6;strokeWidth=1.5;fontSize=9.5;fontColor=#831843;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1095" y="550" width="450" height="405" as="geometry" />
        </mxCell>

        <!-- ==================== MŨI TÊN KẾT NỐI DATA FLOW ==================== -->
        <!-- DWH to MV Hourly -->
        <mxCell id="arr_dwh_to_hourly" value="Ghép nối &amp; Nén 15m-&gt;1h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9.5;fontStyle=1;fontColor=#15803D;" edge="1" parent="1" source="box_dwh_src" target="box_mv_hourly">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MV Hourly to MV Daily -->
        <mxCell id="arr_hourly_to_daily" value="Tổng hợp cấp Ngày &amp; Lũy kế" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9.5;fontStyle=1;fontColor=#15803D;" edge="1" parent="1" source="box_mv_hourly" target="box_mv_daily">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Materialized Views to Tableau Serving -->
        <mxCell id="arr_mv_to_tableau" value="Tableau Native Query (&lt;100ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9.5;fontStyle=1;fontColor=#2563EB;" edge="1" parent="1" source="box_mv_daily" target="box_tableau_serving">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gestalt to Tableau -->
        <mxCell id="arr_gestalt_to_tableau" value="Quy chuẩn UI/UX Dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DB2777;strokeWidth=1.8;endArrow=classic;endFill=1;fontSize=9.5;fontStyle=1;fontColor=#DB2777;" edge="1" parent="1" source="box_palette" target="box_tableau_serving">
          <mxGeometry relative="1" as="geometry">
