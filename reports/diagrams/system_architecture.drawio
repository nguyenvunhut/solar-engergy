        <mxCell id="e_s2" edge="1" parent="1" source="stg_pipeline" target="stg_buf_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;">
