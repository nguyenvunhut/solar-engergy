        <!-- DW to BI Mart -->
        <mxCell id="e_dw_to_bi" edge="1" parent="1" source="dw_fact_gen" target="mart_bi_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;">
