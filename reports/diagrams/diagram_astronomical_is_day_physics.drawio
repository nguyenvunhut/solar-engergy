        </mxCell>
        <mxCell id="night_box_draw" value="VÙNG BAN ĐÊM (α ≤ -0.833° | is_day = 0) → Gán E = 0.0 kWh (Khử 100% Zero Drift)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=9.5;fontStyle=1;align=center;" vertex="1" parent="1">
