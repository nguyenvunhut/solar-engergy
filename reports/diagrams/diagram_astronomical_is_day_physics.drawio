        </mxCell>
        <mxCell id="k2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="670" y="115" width="670" height="450" as="geometry" />
        </mxCell>
        <mxCell id="k2_hdr" value="KHỐI 2: 4 BƯỚC CÔNG THỨC THIÊN VĂN LƯỢNG GIÁC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="115" width="670" height="36" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="1. Góc Năm Phân Số (Fractional Year γ)&#xa;γ = (2π / 365) * (DOY - 1 + (Hour - 12) / 24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontStyle=1;fontColor=#1E40AF;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="160" width="640" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="2. Phương trình Thời gian EoT &amp; Độ Xích vĩ δ&#xa;• EoT = 229.18 * (0.000075 + 0.001868 cos γ - 0.032077 sin γ - 0.014615 cos 2γ - 0.040849 sin 2γ)&#xa;• δ = 0.006918 - 0.399912 cos γ + 0.070257 sin γ - 0.006758 cos 2γ + 0.000907 sin 2γ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=10.5;fontStyle=1;fontColor=#5B21B6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="245" width="640" height="95" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="3. Giờ Mặt Trời Thực TST &amp; Góc Giờ ω&#xa;TST = Local_Time + EoT + 4*lon - 60*TZ   [phút]  |  ω = (TST / 4) - 180°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=11.5;fontStyle=1;fontColor=#854D0E;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="350" width="640" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="4. Góc Nâng Mặt Trời α &amp; Cờ Nhị Phân is_day&#xa;sin(α) = sin(φ)·sin(δ) + cos(φ)·cos(δ)·cos(ω)  |  is_day = 1 nếu α &gt; -0.833°; else 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=11.5;fontStyle=1;fontColor=#064E3B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="685" y="435" width="640" height="75" as="geometry" />
        </mxCell>
        <mxCell id="k3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="585" width="1320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="k3_hdr" value="KHỐI 3: Ý NGHĨA NGHIỆP VỤ &amp; ỨNG DỤNG TRONG PIPELINE TIỀN XỬ LÝ &amp; BẢO TRÌ O&amp;M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7E22CE;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="585" width="1320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="k3_c1" value="1. Khử Trôi Điểm 0 (Zero Drift)&#xa;-----------------------------------------------------------------&#xa;• Khi is_day = 0 hoặc GHI &lt;= 20 W/m²:&#xa;   Gán chính xác E = 0.0 kWh&#xa;• Làm sạch 50,64% kho DWH (1.383.493 dòng)&#xa;• Triệt tiêu 100% dòng rò cảm biến CT ban đêm&#xa;• Bảo toàn tính toàn vẹn năng lượng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.8;fontSize=11.5;fontStyle=1;fontColor=#1D4ED8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="630" width="410" height="260" as="geometry" />
        </mxCell>
        <mxCell id="k3_c2" value="2. Tách Tập Huấn Luyện ML&#xa;-----------------------------------------------------------------&#xa;• Lọc 100% dữ liệu đêm khỏi mô hình&#xa;   hồi quy đa biến và LightGBM&#xa;• Ngăn chặn hiện tượng lệch dự báo Zero-Inflation&#xa;• Nâng cao hệ số R² chuỗi thời gian từ 0,62 lên 0,88&#xa;• Dự báo chính xác sản lượng đỉnh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.8;fontSize=11.5;fontStyle=1;fontColor=#047857;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="465" y="630" width="410" height="260" as="geometry" />
        </mxCell>
        <mxCell id="k3_c3" value="3. Phân Định Bản Chất Lỗi O&amp;M&#xa;-----------------------------------------------------------------&#xa;• is_day = 1 &amp; P = 0: Ngắt Inverter, hỏng tấm pin&#xa;   (Mã: LOW_ENERGY_STRONG_SUN)&#xa;• is_day = 0 &amp; P &gt; 0: Rò điện tự dùng, nhiễu SCADA&#xa;   (Mã: HIGH_ENERGY_NO_SUN)&#xa;• Độ chính xác chẩn đoán sự cố đạt 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.8;fontSize=11.5;fontStyle=1;fontColor=#B45309;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="895" y="630" width="410" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
