        <mxCell id="info_day" value="VÙNG BAN NGÀY (is_day = 1)&#xa;• Bức xạ GHI &gt; 20 W/m²&#xa;• Đưa vào Huấn luyện ML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1.2;fontColor=#1E40AF;fontSize=10.2;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
