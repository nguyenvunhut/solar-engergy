        <mxCell id="1" parent="0" />
        <mxCell id="t0" value="KIẾN TRÚC PIPELINE XỬ LÝ DỮ LIỆU ĐA TẦNG (6-LAYER DATA LAKEHOUSE)&#xa;Điều phối qua Python CLI (srcs/06_run_pipeline/main.py) | Quản lý giao dịch ACID &amp; Tối ưu hóa Supabase DWH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col1_b" value="1. BRONZE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col1_t" value="1. INGESTION&#xa;(Bronze Layer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="32" y="145" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col1_body" value="[Nguồn Thu thập]&#xa;• UNISOLAR Dataset:&#xa;  42 trạm phát 15p&#xa;  2.731.946 dòng&#xa;• Open-Meteo API:&#xa;  ERA5-Land 1 giờ&#xa;  11 biến khí tượng&#xa;  + Cờ is_day thiên văn&#xa;• AEMO Victoria:&#xa;  Biểu giá điện FiT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="32" y="190" width="184" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="246" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col2_b" value="2. STAGING LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="256" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col2_t" value="2. STAGING&#xa;(Silver-1 Layer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="258" y="145" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col2_body" value="[Vùng Đệm Lưu trữ]&#xa;• Supabase Storage:&#xa;  Bucket raw-data&#xa;  Backup tệp nén CSV&#xa;• Staging Tables:&#xa;  stg_solar_gen (15m)&#xa;  stg_weather (1h)&#xa;• Resampling Lưới:&#xa;  Đồng bộ mốc 15 phút&#xa;  Kiểu VARCHAR an toàn" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="258" y="190" width="184" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="472" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col3_b" value="3. TRANSFORM LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="482" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col3_t" value="3. TRANSFORM&#xa;(Silver-2 Layer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="484" y="145" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col3_body" value="[Làm sạch &amp; Gán cờ]&#xa;• Causal Imputation:&#xa;  - Đêm: Gán 0.0 kWh&#xa;  - &lt;=30p: Tuyến tính&#xa;  - 45p-2h: PCHIP Spline&#xa;  - &gt;2h: Hồi quy đa biến&#xa;• GMM-IF Outliers:&#xa;  - Phân đoạn CART&#xa;  - Local GMM + IF&#xa;  - Kẹp trần 1.20x Pstc" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="484" y="190" width="184" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="698" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col4_b" value="4. GOLD DWH LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="708" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col4_t" value="4. DWH CORE&#xa;(Gold Layer)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="710" y="145" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col4_body" value="[Kho Dữ liệu Chuẩn]&#xa;• Galaxy Schema:&#xa;  - fact_solar_gen&#xa;  - fact_weather&#xa;• 4 Dimension chung:&#xa;  site, geo, date/time,&#xa;  weather_type&#xa;• Tối ưu hóa SQL:&#xa;  - Partition theo Năm&#xa;  - Composite Indexes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="710" y="190" width="184" height="500" as="geometry" />
        </mxCell>
