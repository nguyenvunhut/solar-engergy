<mxfile host="Electron" modified="2026-08-20T02:25:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diag_3_1" name="Pipeline Architecture">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#F8FAFC" math="0" shadow="0">
      <root>
