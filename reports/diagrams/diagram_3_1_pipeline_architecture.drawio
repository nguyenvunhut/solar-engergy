<mxfile host="Electron" modified="2026-08-23T22:16:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diag_3_1" name="Pipeline Architecture">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t0" value="KIẾN TRÚC ĐƯỜNG ỐNG XỬ LÝ DỮ LIỆU ĐA TẦNG (6-LAYER DATA PIPELINE)&#xa;Điều phối qua Python CLI (srcs/06_run_pipeline/main.py) | Quản lý giao dịch ACID &amp; Tối ưu hóa Supabase DWH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col1_b" value="LAYER 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col1_t" value="1. INGESTION LAYER&#xa;[Nguồn Thu Thập]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="32" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col1_body" value="• UNISOLAR Telemetry:&#xa;  - 42 trạm phát PV&#xa;  - Chu kỳ 15 phút (0.25h)&#xa;  - 2.731.946 dòng sạch&#xa;&#xa;• Open-Meteo REST API:&#xa;  - ERA5-Land (1 giờ)&#xa;  - 850.752 dòng khí tượng&#xa;  - 11 biến WMO + is_day&#xa;&#xa;• AEMO Victoria NEM:&#xa;  - Biểu giá FiT 0.16 AUD/kWh&#xa;&#xa;• Quản trị Lưu trữ:&#xa;  - DVC &amp; S3 Buckets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="32" y="185" width="184" height="505" as="geometry" />
        </mxCell>
        <mxCell id="col2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="246" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col2_b" value="LAYER 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="256" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col2_t" value="2. STAGING LAYER&#xa;[Vùng Đệm Lưu Trữ]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="258" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col2_body" value="• Supabase S3 Storage:&#xa;  - Bucket raw-data bất biến&#xa;  - Backup tệp nén an toàn&#xa;&#xa;• Staging Tables (VARCHAR):&#xa;  - stg_solar_gen (15m)&#xa;  - stg_weather (1h)&#xa;  - stg_solar_site &amp; campus&#xa;&#xa;• Cơ chế Resampling Lưới:&#xa;  - Đồng bộ mốc 15 phút&#xa;  - Cột kiểu VARCHAR an toàn&#xa;&#xa;• Kiểm toán QA/QC:&#xa;  - MD5 Fingerprint đối soát" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="258" y="185" width="184" height="505" as="geometry" />
        </mxCell>
        <mxCell id="col3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="472" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col3_b" value="LAYER 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="482" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col3_t" value="3. TRANSFORM LAYER&#xa;[Làm Sạch &amp; Gán Cờ]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#5B21B6;" vertex="1" parent="1">
          <mxGeometry x="484" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col3_body" value="• Điền khuyết Nhân quả:&#xa;  - Ban đêm: Gán 0.0 kWh&#xa;  - &lt;=30p: Tuyến tính&#xa;  - 45p-2h: PCHIP Spline&#xa;  - &gt;2h: Hồi quy đa biến&#xa;&#xa;• Căn chỉnh Nhân quả:&#xa;  - Floor-Hour Lookup (Δt&lt;=0)&#xa;  - Triệt tiêu 100% rò rỉ&#xa;&#xa;• Phân lớp Dị thường GMM-IF:&#xa;  - Phân đoạn lá CART&#xa;  - GMM + Isolation Forest&#xa;  - 5 Rào chắn Vật lý" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="484" y="185" width="184" height="505" as="geometry" />
        </mxCell>
        <mxCell id="col4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="698" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col4_b" value="LAYER 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="708" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col4_t" value="4. DWH CORE LAYER&#xa;[Kho Dữ Liệu Chuẩn Hóa]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="710" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col4_body" value="• Mô hình Galaxy Schema:&#xa;  - fact_solar_gen (15m)&#xa;  - fact_weather (1h)&#xa;&#xa;• 5 Bảng Chiều Chung:&#xa;  - dim_solar_site (42 site)&#xa;  - dim_geography (5 campus)&#xa;  - dim_date (full_date, mùa)&#xa;  - dim_time (96 mốc 15p)&#xa;  - dim_weather_type (WMO)&#xa;&#xa;• Tối ưu Hóa Cơ sở Dữ liệu:&#xa;  - Partition theo Năm&#xa;  - Composite Indexes FK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="710" y="185" width="184" height="505" as="geometry" />
        </mxCell>
        <mxCell id="col5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="924" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col5_b" value="LAYER 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="934" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col5_t" value="5. DATA MARTS LAYER&#xa;[Siêu Thị Dữ Liệu]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="936" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col5_body" value="• BI Mart (Phân tích BI):&#xa;  - Nén 4 block 15p về 1h&#xa;  - mv_bi_mart_hourly_measures:&#xa;    + PR actual, adjusted, correct&#xa;    + Loss_temp (14.8%)&#xa;    + Inverter Clipping (2.3%)&#xa;    + Doanh thu FiT &amp; CO2&#xa;&#xa;• ML Mart (Học máy ML):&#xa;  - v4_cleaned.parquet&#xa;  - Feature Store (40 biến)&#xa;  - Lags (t-1, t-4, t-96)&#xa;  - Rolling Statistics" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="936" y="185" width="184" height="505" as="geometry" />
        </mxCell>
        <mxCell id="col6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1150" y="100" width="208" height="700" as="geometry" />
        </mxCell>
        <mxCell id="col6_b" value="LAYER 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="115" width="188" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col6_t" value="6. SERVING LAYER&#xa;[Ứng Dụng Phân Tích]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="1162" y="142" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="col6_body" value="• Tableau Desktop (BI):&#xa;  - Pooler Port 6543 (Read-only)&#xa;  - Dash 1: Executive Overview&#xa;    (CF, 74.98 GWh, ESG)&#xa;  - Dash 2: Efficiency &amp; Loss&#xa;    (Dual-Axis, Heatmap nhiệt)&#xa;  - Dash 3: Anomaly &amp; CBM&#xa;    (Cảnh báo O&amp;M, Rò rỉ đêm)&#xa;&#xa;• Machine Learning (AI):&#xa;  - LightGBM (Huber Loss)&#xa;  - Horizons: 15p &amp; 1h tới&#xa;  - SHAP Explainability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1E293B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="185" width="184" height="505" as="geometry" />
        </mxCell>
