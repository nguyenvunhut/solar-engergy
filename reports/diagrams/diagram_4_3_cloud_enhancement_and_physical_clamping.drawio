        <mxCell id="pv_pnl" value="TẤM PIN QUANG ĐIỆN (PV ARRAY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
